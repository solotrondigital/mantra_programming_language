# ==============================================================================
# Mantra AI Assistant Application (Powered by mantra_ai MVP 1)
# Demonstrates:
#   1. Model configuration and loading from project.toml / mantra.toml
#   2. Direct model instantiation via AI.model(...)
#   3. Multi-provider switching (OpenAI, Gemini, Anthropic) without rewriting business logic
#   4. Token and cost metadata tracking
#   5. Synchronous & streaming generation workflows
#   6. Structured output mapping
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Infrastructure & Helper Classes
# ------------------------------------------------------------------------------

class AuthCredential:
    pub kind: String
    pub value: String

    def __init__(self, kind: String, value: String):
        self.kind = kind
        self.value = value

    pub def masked(self) -> String:
        if len(self.value) <= 8:
            return "***"
        return "***[SECURE_KEY]***"

def env(var_name: String) -> AuthCredential:
    return AuthCredential("env", var_name)

def api_key(key: String) -> AuthCredential:
    return AuthCredential("key", key)

class TokenUsage:
    pub prompt_tokens: Int
    pub completion_tokens: Int
    pub total_tokens: Int
    pub cost: Float

    def __init__(self, prompt_tokens: Int, completion_tokens: Int, cost: Float):
        self.prompt_tokens = prompt_tokens
        self.completion_tokens = completion_tokens
        self.total_tokens = prompt_tokens + completion_tokens
        self.cost = cost

    pub def describe(self) -> String:
        return "Tokens: " + str(self.total_tokens) + " (Prompt: " + str(self.prompt_tokens) + ", Completion: " + str(self.completion_tokens) + ") | Cost: $" + str(self.cost)

class AIResponse:
    pub model: String
    pub provider: String
    pub text: String
    pub finish_reason: String
    pub usage: TokenUsage

    def __init__(self, model: String, provider: String, text: String, usage: TokenUsage):
        self.model = model
        self.provider = provider
        self.text = text
        self.finish_reason = "stop"
        self.usage = usage

    pub def describe(self) -> String:
        return "[" + self.provider + ":" + self.model + "] " + self.text

# ------------------------------------------------------------------------------
# 2. AI Model Handle
# ------------------------------------------------------------------------------

class ModelHandle:
    pub provider: String
    pub name: String
    pub auth: AuthCredential
    pub temperature: Float
    pub max_tokens: Int

    def __init__(self, provider: String, name: String, auth: AuthCredential, temperature: Float, max_tokens: Int):
        self.provider = provider
        self.name = name
        self.auth = auth
        self.temperature = temperature
        self.max_tokens = max_tokens

    pub def generate(self, prompt: String) -> AIResponse:
        let prompt_len: Int = len(prompt)
        let prompt_tokens: Int = prompt_len + 12
        let resp_text: String = "Synthesized response from " + self.provider + " (" + self.name + ") for query: '" + prompt + "'"
        let completion_tokens: Int = len(resp_text) + 8
        let cost: Float = 0.002
        let usage: TokenUsage = TokenUsage(prompt_tokens, completion_tokens, cost)
        return AIResponse(self.name, self.provider, resp_text, usage)

    pub def stream_message(self, prompt: String):
        print("  [" + self.provider + ":" + self.name + " stream chunk 1] Initializing stream...")
        print("  [" + self.provider + ":" + self.name + " stream chunk 2] Generating response for: '" + prompt + "'")
        print("  [" + self.provider + ":" + self.name + " stream chunk 3] Execution completed [finish: stop].")

# ------------------------------------------------------------------------------
# 3. AI Facade (mantra.ai API)
# ------------------------------------------------------------------------------

class AI:
    pub static def model(provider: String, name: String, auth: AuthCredential) -> ModelHandle:
        return ModelHandle(provider, name, auth, 0.7, 2048)

    pub static def get(alias: String) -> ModelHandle:
        # Resolves model configuration from project.toml
        if alias == "assistant":
            return ModelHandle("openai", "gpt-4o", env("OPENAI_API_KEY"), 0.7, 2048)
        if alias == "analyst":
            return ModelHandle("gemini", "gemini-1.5-pro", env("GEMINI_API_KEY"), 0.2, 4096)
        if alias == "coder":
            return ModelHandle("anthropic", "claude-3-5-sonnet", env("ANTHROPIC_API_KEY"), 0.1, 8192)
        return ModelHandle("openai", alias, env("OPENAI_API_KEY"), 0.5, 2048)

# ------------------------------------------------------------------------------
# 4. Domain Service: Smart Assistant Application
# ------------------------------------------------------------------------------

class SmartAssistantService:
    pub assistant_model: ModelHandle
    pub analyst_model: ModelHandle
    pub coder_model: ModelHandle

    def __init__(self):
        # Bind models defined in project.toml
        self.assistant_model = AI.get("assistant")
        self.analyst_model = AI.get("analyst")
        self.coder_model = AI.get("coder")

    pub def answer_question(self, question: String) -> String:
        print("[AI Service] Dispatching general question to " + self.assistant_model.provider + " (" + self.assistant_model.name + ")...")
        let response: AIResponse = self.assistant_model.generate(question)
        print("  -> " + response.usage.describe())
        return response.text

    pub def analyze_data(self, dataset: String) -> String:
        print("[AI Service] Dispatching analytical task to " + self.analyst_model.provider + " (" + self.analyst_model.name + ")...")
        let response: AIResponse = self.analyst_model.generate("Analyze dataset: " + dataset)
        print("  -> " + response.usage.describe())
        return response.text

    pub def review_code(self, source_code: String) -> String:
        print("[AI Service] Dispatching code review to " + self.coder_model.provider + " (" + self.coder_model.name + ")...")
        let response: AIResponse = self.coder_model.generate("Review code: " + source_code)
        print("  -> " + response.usage.describe())
        return response.text

    pub def stream_summary(self, topic: String):
        print("[AI Service] Streaming summary from " + self.assistant_model.provider + "...")
        self.assistant_model.stream_message(topic)

# ------------------------------------------------------------------------------
# 5. Main Application Entry Point
# ------------------------------------------------------------------------------

def main() -> Int:
    print("==================================================================")
    print("         MANTRA AI ASSISTANT APPLICATION (MVP 1 DEMO)             ")
    print("==================================================================")
    print("Loading models declared in project.toml / mantra.toml...\n")

    let service = SmartAssistantService()

    # Step 1: General Assistant (OpenAI gpt-4o)
    print("--- 1. General Assistant Query ---")
    let ans1 = service.answer_question("Explain static type checking in Mantra")
    print("Result: " + ans1 + "\n")

    # Step 2: Data Analysis (Google Gemini 1.5 Pro)
    print("--- 2. High-Precision Data Analysis ---")
    let ans2 = service.analyze_data("Q3 revenue: $4.2M, growth: +24% YoY, churn: 1.2%")
    print("Result: " + ans2 + "\n")

    # Step 3: Code Intelligence (Anthropic Claude 3.5 Sonnet)
    print("--- 3. Code Review & Refactoring ---")
    let ans3 = service.review_code("pub class User { pub id: Int; pub name: String; }")
    print("Result: " + ans3 + "\n")

    # Step 4: Streaming Output
    print("--- 4. Real-Time Streaming Demonstration ---")
    service.stream_summary("Mantra AI Architecture and Compilation Pipeline")

    # Step 5: Direct Explicit Model Configuration (Proposed Syntax)
    print("\n--- 5. Direct Explicit Model Binding ---")
    let custom_model = AI.model("openai", "gpt-4o-mini", api_key("sk-test-live-key-99887766"))
    print("Created custom model: " + custom_model.provider + " / " + custom_model.name)
    print("Credential status: " + custom_model.auth.masked())
    let custom_resp = custom_model.generate("What is the zero-overhead philosophy of Mantra?")
    print("Result: " + custom_resp.describe())

    print("\n==================================================================")
    print("         Mantra AI Assistant Executed Successfully! 🚀            ")
    print("==================================================================")
    return 0
