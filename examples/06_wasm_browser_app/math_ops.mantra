# Mantra WebAssembly Calculation Core
# Compiled to WebAssembly for execution inside browser runtimes

def add(a: Int, b: Int) -> Int:
    return a + b

def multiply(x: Float, y: Float) -> Float:
    return x * y

def factorial(n: Int) -> Int:
    mut result = 1
    mut i = 1
    while i <= n:
        result = result * i
        i = i + 1
    return result

def main() -> Int:
    print("Mantra WebAssembly Core Loaded Successfully!")
    let sum = add(20, 22)
    print(sum)
    return 0
