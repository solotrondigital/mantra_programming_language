# ==============================================================================
# Mantra Stress Test: High-Throughput Allocations & Reference Counting
# tests/stress/stress_allocations.mantra
# ==============================================================================

class Node:
    def __init__(self, id: Int, label: String):
        self.id = id
        self.label = label

    pub def get_id(self) -> Int:
        return self.id

def create_and_drop_batch(batch_size: Int) -> Int:
    mut count = 0
    mut i = 0
    while i < batch_size:
        let n = Node(i, "node_payload")
        count = count + n.get_id()
        i = i + 1
    return count

def main() -> Int:
    print("Running High-Throughput Allocation Stress Test (10,000 iterations)...")
    mut runs = 0
    mut sum = 0
    while runs < 10:
        sum = sum + create_and_drop_batch(1000)
        runs = runs + 1

    print("Allocation Stress Test Passed! Total Sum: " + str(sum))
    return 0

