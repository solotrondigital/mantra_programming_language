# Conformance Test 10: Multi-level Constructors and Super Method Calls

class Component:
    def __init__(self, id: String):
        self.id = id
        self.enabled = True

    pub def describe(self) -> String:
        return "Component[" + self.id + "]"

class UIElement extends Component:
    def __init__(self, id: String, x: Int, y: Int):
        super().__init__(id)
        self.x = x
        self.y = y

    override pub def describe(self) -> String:
        return super().describe() + " at (" + str(self.x) + ", " + str(self.y) + ")"

class Button extends UIElement:
    def __init__(self, id: String, x: Int, y: Int, label: String):
        super().__init__(id, x, y)
        self.label = label
        self.clicks = 0

    pub def click(self):
        self.clicks = self.clicks + 1

    override pub def describe(self) -> String:
        return super().describe() + " label='" + self.label + "'"

def main() -> Int:
    print("Testing Constructors and Super Calls...")
    btn = Button("btn_submit", 100, 200, "Submit")
    
    assert(btn.id == "btn_submit")
    assert(btn.enabled == True)
    assert(btn.x == 100)
    assert(btn.y == 200)
    assert(btn.label == "Submit")
    assert(btn.clicks == 0)

    btn.click()
    btn.click()
    assert(btn.clicks == 2)

    let desc = btn.describe()
    print(desc)
    assert(desc == "Component[btn_submit] at (100, 200) label='Submit'")

    print("Test 10 passed!")
    return 0

