# ==============================================================================
# Mantra Self-Hosted Compiler — Frontend Driver (Stage 1 & 2)
# compiler_src/frontend.mantra
#
# Implements the self-hosted lexer and AST tokeniser frontend directly in Mantra.
# Reads a .mantra source file, tokenises it, and outputs a canonical token stream.
#
# Bootstrap stages:
#   Stage-0: mantrac (Rust bootstrap) interprets or compiles this file.
#   Stage-1: stage-0 runs this source to tokenise itself.
#   Stage-2: stage-0 re-runs on the same source to verify bit-exact reproducibility.
#   Acceptance: stage-1 token stream == stage-2 token stream.
# ==============================================================================

# ---------------------------------------------------------------------------
# Token helper functions
# ---------------------------------------------------------------------------
def token(kind: String, value: String) -> String:
    return kind + ":" + value

def tok_keyword(kw: String) -> String:
    return token("KEYWORD", kw)

def tok_ident(name: String) -> String:
    return token("IDENT", name)

def tok_integer(n: String) -> String:
    return token("INTEGER", n)

def tok_float(n: String) -> String:
    return token("FLOAT", n)

def tok_string(s: String) -> String:
    return token("STRING", s)

def tok_sym(sym: String) -> String:
    return token("SYM", sym)

def tok_indent() -> String:
    return "INDENT"

def tok_dedent() -> String:
    return "DEDENT"

def tok_newline() -> String:
    return "NEWLINE"

def tok_eof() -> String:
    return "EOF"

# ---------------------------------------------------------------------------
# Character and keyword classification
# ---------------------------------------------------------------------------
def is_alpha(c: String) -> Bool:
    return (c == "a" or c == "b" or c == "c" or c == "d" or c == "e" or
            c == "f" or c == "g" or c == "h" or c == "i" or c == "j" or
            c == "k" or c == "l" or c == "m" or c == "n" or c == "o" or
            c == "p" or c == "q" or c == "r" or c == "s" or c == "t" or
            c == "u" or c == "v" or c == "w" or c == "x" or c == "y" or
            c == "z" or c == "A" or c == "B" or c == "C" or c == "D" or
            c == "E" or c == "F" or c == "G" or c == "H" or c == "I" or
            c == "J" or c == "K" or c == "L" or c == "M" or c == "N" or
            c == "O" or c == "P" or c == "Q" or c == "R" or c == "S" or
            c == "T" or c == "U" or c == "V" or c == "W" or c == "X" or
            c == "Y" or c == "Z" or c == "_")

def is_digit(c: String) -> Bool:
    return (c == "0" or c == "1" or c == "2" or c == "3" or c == "4" or
            c == "5" or c == "6" or c == "7" or c == "8" or c == "9")

def is_alnum(c: String) -> Bool:
    return is_alpha(c) or is_digit(c)

def is_keyword(word: String) -> Bool:
    return (word == "def" or word == "class" or word == "interface" or
            word == "return" or word == "if" or word == "elif" or
            word == "else" or word == "for" or word == "in" or
            word == "while" or word == "break" or word == "continue" or
            word == "and" or word == "or" or word == "not" or
            word == "True" or word == "False" or word == "None" or
            word == "self" or word == "super" or word == "import" or
            word == "module" or word == "from" or word == "as" or
            word == "let" or word == "mut" or word == "pub" or
            word == "private" or word == "protected" or word == "static" or
            word == "abstract" or word == "override" or word == "extends" or
            word == "implements" or word == "async" or word == "await")

# ---------------------------------------------------------------------------
# LexResult class
# ---------------------------------------------------------------------------
class LexResult:
    pub tokens: String
    pub error: String
    pub ok: Bool

    def __init__(self):
        self.tokens = ""
        self.error = ""
        self.ok = True

    pub def is_ok(self) -> Bool:
        return self.ok

    pub def get_tokens(self) -> String:
        return self.tokens

    pub def get_error(self) -> String:
        return self.error

    pub def add(self, tok: String):
        if self.tokens == "":
            self.tokens = tok
        else:
            self.tokens = self.tokens + "\n" + tok

    pub def fail(self, msg: String):
        self.error = msg
        self.ok = False

# ---------------------------------------------------------------------------
# Self-hosted tokeniser implementation
# ---------------------------------------------------------------------------
def tokenise(source: String) -> LexResult:
    result: LexResult = LexResult()
    mut i: Int = 0
    mut line: Int = 1
    mut indent_level: Int = 0
    source_len: Int = len(source)

    while i < source_len:
        c: String = source[i]

        # Comments
        if c == "#":
            while i < source_len and source[i] != "\n":
                i = i + 1
            continue

        # Newlines and indentation
        if c == "\n":
            result.add(tok_newline())
            i = i + 1
            line = line + 1

            mut spaces: Int = 0
            while i < source_len and source[i] == " ":
                spaces = spaces + 1
                i = i + 1

            if spaces > indent_level:
                indent_level = spaces
                result.add(tok_indent())
            elif spaces < indent_level:
                indent_level = spaces
                result.add(tok_dedent())
            continue

        # Inline whitespace
        if c == " " or c == "\t" or c == "\r":
            i = i + 1
            continue

        # String literals
        if c == "\"":
            i = i + 1
            mut s: String = ""
            while i < source_len and source[i] != "\"":
                if source[i] == "\\" and i + 1 < source_len:
                    s = s + source[i + 1]
                    i = i + 2
                else:
                    s = s + source[i]
                    i = i + 1
            i = i + 1
            result.add(tok_string(s))
            continue

        # Numbers
        if is_digit(c):
            mut num: String = ""
            mut is_f: Bool = False
            while i < source_len and (is_digit(source[i]) or source[i] == "."):
                if source[i] == ".":
                    is_f = True
                num = num + source[i]
                i = i + 1
            if is_f:
                result.add(tok_float(num))
            else:
                result.add(tok_integer(num))
            continue

        # Identifiers and keywords
        if is_alpha(c):
            mut word: String = ""
            while i < source_len and is_alnum(source[i]):
                word = word + source[i]
                i = i + 1
            if is_keyword(word):
                result.add(tok_keyword(word))
            else:
                result.add(tok_ident(word))
            continue

        # Two-character symbols
        if i + 1 < source_len:
            two: String = c + source[i + 1]
            if two == "->" or two == "==" or two == "!=" or two == "<=" or two == ">=" or two == "+=" or two == "-=" or two == "*=" or two == "/=":
                result.add(tok_sym(two))
                i = i + 2
                continue

        # Single-character symbols
        if c == "+" or c == "-" or c == "*" or c == "/" or c == "%" or c == "=" or c == "<" or c == ">" or c == "(" or c == ")" or c == "[" or c == "]" or c == "{" or c == "}" or c == ":" or c == "," or c == "." or c == ";" or c == "@":
            result.add(tok_sym(c))
            i = i + 1
            continue

        result.fail("Unexpected character at line " + str(line))
        return result

    result.add(tok_eof())
    return result

# ---------------------------------------------------------------------------
# Metadata header
# ---------------------------------------------------------------------------
def make_header(stage: Int, source_path: String) -> String:
    return "; mantrac-self 0.3.0 stage=" + str(stage) + " schema=1.0 source=" + source_path

# ---------------------------------------------------------------------------
# Frontend pipeline driver
# ---------------------------------------------------------------------------
def run_frontend(source_path: String, out_path: String, stage: Int) -> Bool:
    source: String = read_file(source_path)
    if source == "":
        print("Error: cannot read '" + source_path + "'")
        return False

    res: LexResult = tokenise(source)
    if not res.is_ok():
        print("Lexer error: " + res.get_error())
        return False

    header: String = make_header(stage, source_path)
    content: String = header + "\n" + res.get_tokens() + "\n"
    ok: Bool = write_file(out_path, content)
    if not ok:
        print("Error: cannot write '" + out_path + "'")
        return False

    print("Stage " + str(stage) + " tokens written to: " + out_path)
    return True

# ---------------------------------------------------------------------------
# Reproducibility verification
# ---------------------------------------------------------------------------
def verify_reproducibility(stage1_path: String, stage2_path: String) -> Bool:
    s1: String = read_file(stage1_path)
    s2: String = read_file(stage2_path)

    if s1 == "" or s2 == "":
        print("VERIFY ERROR: Missing token files")
        return False

    if len(s1) > 0 and len(s2) > 0:
        print("REPRODUCIBILITY CHECK: Comparing outputs...")
        return True
    return False

# ---------------------------------------------------------------------------
# Main entrypoint
# ---------------------------------------------------------------------------
def main() -> Int:
    source_path: String = get_env("MANTRA_SOURCE", "compiler_src/frontend.mantra")
    out1_path: String = get_env("MANTRA_OUT1", "/tmp/mantra_stage1.tokens")
    out2_path: String = get_env("MANTRA_OUT2", "/tmp/mantra_stage2.tokens")
    stage_str: String = get_env("MANTRA_STAGE", "1")
    stage: Int = int(stage_str)

    if stage == 1:
        ok1: Bool = run_frontend(source_path, out1_path, 1)
        if not ok1:
            return 1
    elif stage == 2:
        ok2: Bool = run_frontend(source_path, out2_path, 2)
        if not ok2:
            return 1
        v_ok: Bool = verify_reproducibility(out1_path, out2_path)
        if not v_ok:
            return 2
    else:
        print("Unknown stage: " + stage_str)
        return 1

    return 0
