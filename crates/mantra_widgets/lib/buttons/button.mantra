pub class RoundedButton:
    def __init__(self, label: String):
        self._label = label
        self._on_click = ""

    pub def on_click(self, handler: String):
        self._on_click = handler

    pub def render_web(self) -> String:
        return "<button class='mw-btn mw-btn-rounded' onclick='" + self._on_click + "' style='border-radius:9999px;padding:8px 20px;'>" + self._label + "</button>"

    pub def render_android(self) -> String:
        return "<com.google.android.material.button.MaterialButton app:cornerRadius='28dp' android:layout_width='wrap_content' android:layout_height='wrap_content' android:text='" + self._label + "'/>"

    pub def render_ios(self) -> String:
        return "Button(\"" + self._label + "\") { " + self._on_click + " }.clipShape(Capsule())"


