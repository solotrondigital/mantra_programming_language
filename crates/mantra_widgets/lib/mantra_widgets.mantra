pub class MantraApp:
    def __init__(self, title: String, theme: MantraTheme, root_html: String):
        self.title = title
        self.theme = theme
        self.root_html = root_html

    pub def render_document(self) -> String:
        return "<!DOCTYPE html><html><head><meta charset='UTF-8'><meta name='viewport' content='width=device-width, initial-scale=1.0'><title>" + self.title + "</title><style>" + self.theme.to_css() + "</style></head><body><div id='mantra-root'>" + self.root_html + "</div></body></html>"

    pub def start(self) -> Int:
        print("⚡ Mantra UI Application Mounted: " + self.title)
        return 0
