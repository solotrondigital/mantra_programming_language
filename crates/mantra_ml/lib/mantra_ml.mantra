# mantra_ml — Machine Learning and Knowledge Framework (MVP 4)
#
# Executable model, embedding, vector store, and RAG integrations are provided
# by the native Rust package. Host applications bind these interfaces.

pub class ML:
    pub static def version() -> String:
        return "0.7.0"

pub class Document:
    def __init__(self, id: String, source: String, text: String):
        self.id = id
        self.source = source
        self.text = text

pub class SearchResult:
    def __init__(self, id: String, text: String, score: Float):
        self.id = id
        self.text = text
        self.score = score

