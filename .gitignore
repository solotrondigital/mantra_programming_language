# Rust build artifacts
target/
**/*.rs.bk
Cargo.lock.bak

# Release binaries and installer packages (Upload these to GitHub Releases, not git repo)
dist/
installer/**/bin/
installer/bin/
installer/linux/*.tar.gz
installer/linux/*.sh
installer/macos/*.dmg
installer/windows/*.zip

# OS metadata
.DS_Store
Thumbs.db
*.swp
*~

# IDE configurations
.idea/
.vscode/

# Ignore all markdown files in root and subdirectories
*.md
**/*.md
# Allow only README.md to be tracked
!README.md
!**/README.md
components_dev_docs/*.md